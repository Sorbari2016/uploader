<header id="main-header">
   <!-- Logo  -->
  <div class="logo">
    <a href="/" aria-label="Home page">
      <svg width="320" height="100" viewBox="0 0 320 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="320" height="100" rx="50" fill="#0F6E56" />
          <g>
            <path d="M48 60 a16 16 0 0 1 4 -31 a20 20 0 0 1 38 -8 a17 17 0 0 1 20 17 a15 15 0 0 1 -2 22 z"
              fill="#FFFFFF"/>

            <rect x="42" y="58" width="64" height="6" rx="3" fill="#FFFFFF" />
          </g>

          <text x="130" y="58"font-family="Arial, Helvetica, sans-serif" font-size="26" font-weight="600" fill="#FFFFFF" >
           Conduire
          </text>
        </svg>
    </a>
  </div>

  <!-- Conditionally render Profile btn, or login/sign up  -->
   <% if (isLoggedIn) {%>
     <div class="profile dropdown">
            <a class="btn profile-btn" role="button">
                <img src="/icons/default-user-profile.png" alt="profile icon"> 
                <span class="profile-name"><%= username %></span>
                <span class="dropdown-arrow">⏷</span>
            </a>
            <ul class="dropdown-menu">
                <li><a href="/profile"class="dropdown-item">Profile</a></li>
                <li><a href="/logout"class="dropdown-item">Log out</a></li>
            </ul>
        </div>
    <% } else {%> 
        <div class="split-btns auth-btns">
            <a href="/login" class="btn btn-login" role="button">Login</a>
                <span class="divider">|</span>
            <a href="/register" class="btn btn-signup" role="button">Sign up</a>
        </div>
    <% } %>
</header>
