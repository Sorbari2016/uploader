// Write schema, & models or relations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Define models
model User { 
  id        Int       @id @default(autoincrement()) 
  firstName String
  lastName  String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now()) 
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Optional for soft-deletes

  folders   Folder[] 
  files     File[]

  @@map("users")
}

model Folder {
  id        Int       @id @default(autoincrement())
  name      String?
  ownerId  Int
  owner     User      @relation(fields: [ownerId], references: [id]) 

  parentId Int?      // Optional, since root folders wont have parents
  parent    Folder?   @relation("SubFolders", fields: [parentId], references: [id])
  children  Folder[]  @relation("SubFolders")

  createdAt DateTime  @default(now()) 
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  files     File[]

  @@index([ownerId, parentId]) // Composite index for browsing directory
  @@index([deletedAt])           // Fast filtering for active vs trashed folders

  @@map("folders")
}


model File {
  id           Int       @id @default(autoincrement())
  name         String
  storagePath String
  size         Int
  mimeType     String

  ownerId     Int
  owner        User      @relation(fields: [ownerId], references: [id])

  folderId    Int?  // files can be uploaded at root level
  folder       Folder?   @relation(fields: [folderId], references: [id])

  createdAt    DateTime  @default(now()) 
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([ownerId, folderId])
  @@index([deletedAt])
  @@index([mimeType])

  @@map("files")
}

// Create model, store session details in db
model Session {
  id        String   @id
  sid       String   @unique
  data      String  
  expiresAt   DateTime
}